# ==============================================================================
# GHOSTTY TERMINAL CONFIGURATION
# ==============================================================================

theme = Breadog
background-opacity = 0.95

# --- TĂNG ĐỘ TƯƠNG PHẢN (CONTRAST) ---
# Ép thuật toán tự động điều chỉnh các màu chói để dễ đọc hơn trên nền sáng
minimum-contrast = 2

# --- TYPOGRAPHY ---
font-family = "JetBrainsMono Nerd Font"
font-size = 13
font-thicken = true
font-thicken-strength = 1
adjust-cell-height = 1

# --- WINDOW & PANES ---
split-divider-color = #cccccc
unfocused-split-opacity = 0.8

# --- COLOR PALETTE ---
palette = 7=#333333
palette = 15=#1a1a1a

# --- KEYBINDINGS & TMUX ---
keybind = cmd+1=unbind
keybind = cmd+2=unbind
keybind = cmd+3=unbind

keybind = cmd+s=text:\x01\x73
keybind = cmd+b=text:\x01\x7a
keybind = super+|=text:\x02%
keybind = super+shift+|=text:\x02"


macos-option-as-alt = left

